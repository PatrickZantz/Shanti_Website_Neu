{
  "name": "shanti-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "shanti-videos" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://DEIN-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": ""
  }
}
