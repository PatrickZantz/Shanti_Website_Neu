---
import Markdown from './Markdown';
import PageIntro from './PageIntro.astro';
import { ContactForm } from './ContactForm';
import type { Entry } from '../lib/content';

interface Props { page: Entry; contact?: boolean }
const { page, contact = false } = Astro.props;
---
<div class="content-wrap">
  <PageIntro eyebrow={page.pageType} title={page.title} lead={page.description || ''} />
  <article class="prose prose-content">
    {page.image ? <div class="detail-art"><img src={page.image} alt="" style="position:absolute;inset:0;width:100%;height:100%" /></div> : null}
    <Markdown>{page.body}</Markdown>
    {contact ? <ContactForm client:load address={page.contactEmail} /> : null}
  </article>
</div>
