---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/hanken-grotesk/300.css';
import '@fontsource/hanken-grotesk/400.css';
import '../styles/global.css';
import { CalendarDays, Flower2, Heart, House, Leaf, UsersRound, Waves } from 'lucide-react';
import { getNavigation, getSiteImages, getSiteSettings } from '../lib/content';

interface Props { title?: string; description?: string; noindex?: boolean }
const site = await getSiteSettings();
const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.site_name}` : `${site.site_name} | ${site.tagline.replace(/\s*\n\s*/g, ' ')}`;
const lines = (text: string) => text.split('\n');

const icons = { Flower2, Waves, CalendarDays, Leaf, House, UsersRound, Heart } as const;
const iconFor = (name?: string) => icons[name as keyof typeof icons];
const navigation = await getNavigation();
const rail = navigation.filter((item) => item.placement === 'rail');
const top = navigation.filter((item) => item.placement === 'top');
const footer = navigation.filter((item) => item.placement === 'footer');

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isIn = (href: string) => (href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`));
const inSection = rail.some(({ href }) => isIn(href));
const { railArt } = await getSiteImages();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.site_name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class:list={['site-frame', { 'rail-open': inSection }]} id="site-frame">
      <aside class="side-rail" id="side-rail" aria-label="Bereichsnavigation" aria-hidden={!inSection} inert={!inSection}>
        <a class="brand" href="/"><span class="brand-name">{site.brand_name}</span><span class="brand-tagline">{lines(site.tagline).map((line, i) => <>{i > 0 && <br />}{line}</>)}</span></a>
        <nav class="side-nav">
          {rail.map(({ href, label, note, icon }) => {
            const Icon = iconFor(icon);
            return (
              <a class:list={['side-link', { active: isIn(href) }]} aria-current={isIn(href) ? 'page' : undefined} href={href}>
                {Icon ? <Icon size={18} aria-hidden="true" /> : null}
                <span><strong>{label}</strong><small>{note}</small></span>
              </a>
            );
          })}
        </nav>
        <div class="rail-note"><Heart size={20} aria-hidden="true" /><span>{lines(site.rail_note).map((line, i) => <>{i > 0 && <br />}{line}</>)}</span></div>
        {railArt ? <div class="rail-art" style={`background-image: url(${railArt})`} aria-hidden="true" /> : null}
      </aside>
      <div class="main-column">
        <header class="topbar">
          <a class="brand top-brand" href="/"><span class="brand-name">{site.brand_name}</span><span class="brand-tagline">{lines(site.tagline).map((line, i) => <>{i > 0 && <br />}{line}</>)}</span></a>
          <nav class="top-nav" aria-label="Hauptnavigation">
            {top.map(({ href, label, icon, opens_rail }) => {
              const Icon = iconFor(icon);
              const active = opens_rail ? inSection : isIn(href);
              return opens_rail ? (
                <a class:list={{ active }} href={href} id="praxis-link" aria-expanded={inSection} aria-controls="side-rail" data-in-section={inSection}>{Icon ? <Icon aria-hidden="true" /> : null}<span>{label}</span></a>
              ) : (
                <a class:list={{ active }} href={href}>{Icon ? <Icon aria-hidden="true" /> : null}<span>{label}</span></a>
              );
            })}
          </nav>
        </header>
        <main><slot /></main>
        <footer class="footer">
          <div class="footer-inner">
            <span>© {new Date().getFullYear()} {site.footer_text}</span>
            <nav class="footer-links" aria-label="Rechtliches">
              {footer.map(({ href, label }) => <a href={href}>{label}</a>)}
            </nav>
          </div>
        </footer>
      </div>
    </div>
    <script>
      // Auf Praxis-Seiten klappt der Link die Seitenleiste auf/zu, statt zu navigieren.
      const link = document.getElementById('praxis-link');
      const frame = document.getElementById('site-frame');
      const rail = document.getElementById('side-rail');
      link?.addEventListener('click', (event) => {
        if (link.dataset.inSection !== 'true' || !frame || !rail) return;
        event.preventDefault();
        const open = frame.classList.toggle('rail-open');
        link.setAttribute('aria-expanded', String(open));
        rail.setAttribute('aria-hidden', String(!open));
        rail.toggleAttribute('inert', !open);
      });
    </script>
  </body>
</html>
