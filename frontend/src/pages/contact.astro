---
import Base from '../layouts/Base.astro';
import CmsPage from '../components/CmsPage.astro';
import { getEntry } from '../lib/content';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Seite "contact" fehlt in content/pages');
---
<Base title={page.metaTitle} description={page.metaDescription}>
  <CmsPage page={page} contact />
</Base>
