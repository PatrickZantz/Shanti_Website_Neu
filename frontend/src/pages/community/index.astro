---
import Base from '../../layouts/Base.astro';
import { ContentCard } from '../../components/ContentCard';
import PageIntro from '../../components/PageIntro.astro';
import { getEntries, getSiteImages, getIntro } from '../../lib/content';

const entries = [...(await getEntries('blog')), ...(await getEntries('community'))];
const fallback = (await getSiteImages()).fallbacks?.community;
const intro = await getIntro('community');
---
<Base title={intro.metaTitle} description={intro.metaDescription}>
  <div class="content-wrap">
    <PageIntro eyebrow={intro.eyebrow} title={intro.title} lead={intro.lead} />
    <div class="grid grid-3">{entries.map((entry) => <ContentCard entry={entry} href={`/community/${entry.slug}`} fallbackImage={fallback} />)}</div>
  </div>
</Base>
