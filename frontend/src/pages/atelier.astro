---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { getEntries, getSiteImages, getIntro } from '../lib/content';

const entries = await getEntries('atelier');
const fallback = (await getSiteImages()).fallbacks?.community;
const intro = await getIntro('atelier');
---
<Base title={intro.metaTitle} description={intro.metaDescription}>
  <div class="content-wrap">
    <PageIntro eyebrow={intro.eyebrow} title={intro.title} lead={intro.lead} />
    <div class="grid grid-3">
      {entries.map((entry) => {
        const image = entry.image || fallback;
        return (
          <article class="tile">
            <div class="tile-art">{image ? <img src={image} alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%" /> : null}</div>
            <div class="tile-body"><h3>{entry.title}</h3><p>{entry.description}</p></div>
          </article>
        );
      })}
    </div>
    {intro.body ? <p class="empty-state" style="margin-top: 28px">{intro.body}</p> : null}
  </div>
</Base>
